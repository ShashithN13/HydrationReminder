{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "TypeScript check and Expo lint",
			"type": "shell",
			"command": "npm exec -- tsc --noEmit; npm run lint",
			"isBackground": false
		},
		{
			"label": "Install project dependencies",
			"type": "shell",
			"command": "npm install",
			"isBackground": false
		},
		{
			"label": "Start Expo with cleared cache",
			"type": "shell",
			"command": "npx",
			"args": [
				"expo",
				"start",
				"--clear"
			],
			"isBackground": true
		},
		{
			"label": "Reinstall locked dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"ci"
			],
			"isBackground": false
		}
	]
}